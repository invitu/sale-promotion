<odoo>
    <record id="loyalty_reward_view_form" model="ir.ui.view">
        <field name="model">loyalty.reward</field>
        <field name="inherit_id" ref="loyalty.loyalty_reward_view_form" />
        <field name="arch" type="xml">
            <field name="discount_product_tag_id" position="after">
                <field
                    name="discount_unit_limit"
                    invisible="discount_applicability != 'specific' or discount_mode == 'per_point'"
                />
            </field>
        </field>
    </record>
</odoo>
